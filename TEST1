-- ================== LOADSTRING TEST — TEST 1 (chained) ==================
-- Runs Test 1. On success, fetches TEST2 from GitHub and executes it.

local TOTAL_TESTS = 5
local BASE_URL = "https://raw.githubusercontent.com/oblitsosupport/Loadstring-Ban-tests/refs/heads/main/"

-- ============================================================
-- PRE-TEST INFO STAGE
-- ============================================================
print("This is a Loadstring ban test, it will test in the game if a loadstring is blocked by an anti cheat feature or by settings of the game")
print(string.format("Total Tests: %d", TOTAL_TESTS))
print("Upcoming Test: 1")
print("Information about the emojis it means")
print("✅ - Test suceeded")
print("🟠 - Test upcoming")
print("❌ - Test failed or there are no more tests left")

task.wait(0.5)

-- ============================================================
-- TEST 1
-- ============================================================
print("🟠 Test 1 - Upcoming")

local test1Source = [[
    local ok, result = pcall(function()
        if type(loadstring) ~= "function" then return nil end
        local chunk = loadstring("return 1 + 1")
        if type(chunk) ~= "function" then return nil end
        return chunk()
    end)
    return ok and result == 2
]]

local wrapper = string.format([[
    local ok, result = pcall(function()
        %s
    end)
    return ok, result
]], test1Source)

local loadOk, chunkOrErr = pcall(function()
    if type(loadstring) ~= "function" then error("loadstring is nil") end
    local chunk = loadstring(wrapper)
    if type(chunk) ~= "function" then error("chunk is nil") end
    return chunk
end)

local passed = false

if not loadOk or type(chunkOrErr) ~= "function" then
    passed = false
else
    local runOk, execOk, result = pcall(chunkOrErr)
    passed = runOk and execOk and result == true
end

if passed then
    print("✅ Test 1 - Sucess")
else
    print("❌ Test 1 - Failed")
    print("❌ No more tests left")
    return
end

-- ============================================================
-- FETCH + RUN TEST 2
-- ============================================================
print("🟠 Test 2 - Upcoming")

local fetchOk, source = pcall(function()
    return game:HttpGet(BASE_URL .. "TEST2")
end)

if not fetchOk or type(source) ~= "string" or source == "" then
    print("❌ Test 2 - Failed  (could not fetch TEST2 from GitHub)")
    print("❌ No more tests left")
    return
end

local compileOk, test2Chunk = pcall(function()
    return loadstring(source)
end)

if not compileOk or type(test2Chunk) ~= "function" then
    print("❌ Test 2 - Failed  (TEST2 could not be compiled)")
    print("❌ No more tests left")
    return
end

local execOk, execErr = pcall(test2Chunk)

if not execOk then
    print("❌ Test 2 - Failed  (" .. tostring(execErr) .. ")")
    print("❌ No more tests left")
    return
end

